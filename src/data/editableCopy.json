  "PrivacyPage.506ff3946215": {
    "scope": "PrivacyPage",
    "text": "Privacy Policy"
  },
  "PrivacyPage.3d3e64aef8e3": {
    "scope": "PrivacyPage",
    "text": "Last updated: September 10, 2026"
  },
  "PrivacyPage.628fa20080ca": {
    "scope": "PrivacyPage",
    "text": "This notice explains what this portfolio stores when you browse the site, submit the contact form, or use the private administration area."
  },
  "PrivacyPage.8dc7bf471f75": {
    "scope": "PrivacyPage",
    "text": "1. Information We Collect"
  },
  "PrivacyPage.5a2b7de9dc6c": {
    "scope": "PrivacyPage",
    "text": "The contact form collects the name, email address, subject, service selection, and message you provide. Hosting infrastructure may also process routine request information, such as an IP address, to deliver the site, prevent abuse, and diagnose failures. This application does not add advertising trackers or analytics cookies."
  },
  "PrivacyPage.3022ecbd90f1": {
    "scope": "PrivacyPage",
    "text": "2. Use of Information"
  },
  "PrivacyPage.94016f657397": {
    "scope": "PrivacyPage",
    "text": "Contact information is used to review and respond to your inquiry, prevent duplicate or abusive submissions, and optionally send an inbox notification. Contact details are not sold to advertisers."
  },
  "PrivacyPage.19b70162c48a": {
    "scope": "PrivacyPage",
    "text": "3. Storage and service providers"
  },
  "PrivacyPage.f7cd383fb6ce": {
    "scope": "PrivacyPage",
    "text": "In the hosted configuration, contact submissions and portfolio content are stored in Supabase. Resend may process contact details when optional email notifications are enabled, and the hosting provider processes web requests. Contact messages remain in the admin inbox until the site owner deletes them or applies a separate retention process."
  },
  "PrivacyPage.2962cf2dbf0d": {
    "scope": "PrivacyPage",
    "text": "4. Browser storage"
  },
  "PrivacyPage.3bbeb4d1155b": {
    "scope": "PrivacyPage",
    "text": "The site uses browser storage for theme preferences and a local content cache. The private admin area also stores its sign-in session in browser-accessible storage; it does not use an HttpOnly authentication cookie. Avoid using the admin area on shared devices and sign out when finished."
  },
  "PrivacyPage.d85eb8b670af": {
    "scope": "PrivacyPage",
    "text": "5. Security and your choices"
  },
  "PrivacyPage.42afa70ace86": {
    "scope": "PrivacyPage",
    "text": "Production traffic should use HTTPS, database access is restricted by role-based policies, and server credentials are not included in browser code. No system can guarantee absolute security. You may request access, correction, or deletion of a contact submission through the contact page; the response available may depend on applicable law and the ability to identify the record."
  },
